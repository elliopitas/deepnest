{
  "name": "deepnest",
  "productName": "Deepnest",
  "version": "1.5.6",
  "description": "Deep nesting for Laser and CNC",
  "private": true,
  "main": "main.js",
  "types": "index.d.ts",
  "license": "MIT",
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/deepnest_next?utm_medium=clipboard_copy&utm_source=copyLink&utm_campaign=creatorshare_fan&utm_content=join_link"
    }
  ],
  "scripts": {
    "start": "electron .",
    "printenv": "cross-replace node -e \"console.log(process.env)\"",
    "test": "playwright test",
    "build": "tsc && electron-builder install-app-deps",
    "clean": "rmdir /s /q build dist >nul 2>&1|echo . >nul",
    "clean-all": "rmdir /s /q build dist node_modules bin >nul 2>&1|echo . >nul",
    "dist": "cross-replace npx @electron/packager . deepnest-v$npm_package_version --overwrite --ignore='\\.github' --ignore='\\.vscode' --ignore='\\.husky' --ignore='deepnest-v[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9_-]' --ignore='out' --ignore='renovate\\.json' --ignore='\\.readthedocs\\.yaml' --ignore='CHANGELOG\\.md' --ignore='examples' --ignore='\\.gitignore' --ignore='playwright-report' --ignore='test.log'",
    "build-dist": "electron-builder build --win",
    "build-dist-signed": "electron-builder build --win --publish never",
    "build-linux": "node helper_scripts/stamp-metainfo.js && electron-builder build --linux",
    "build-linux-appimage": "node helper_scripts/stamp-metainfo.js && electron-builder build --linux AppImage",
    "build-linux-flatpak": "node helper_scripts/stamp-metainfo.js && electron-builder build --linux flatpak",
    "build-linux-rpm": "electron-builder build --linux rpm",
    "dist-all": "npm run clean-all && npm install && npm run build && npm run dist",
    "dist-all-signed": "npm run clean-all && npm install && npm run build && npm run build-dist-signed",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "postinstall": "electron-builder install-app-deps",
    "pw:codegen": "node helper_scripts/playwright_codegen.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,html,css,scss,less,json}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "repository": "https://github.com/deepnest-next/deepnest",
  "keywords": [
    "Electron",
    "Nesting",
    "CNC",
    "Laser"
  ],
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "22.15.17",
    "cross-replace": "0.2.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.2",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "dependencies": {
    "@deepnest/calculate-nfp": "202503.13.155300",
    "@deepnest/svg-preprocessor": "0.2.0",
    "@electron/remote": "2.1.3",
    "axios": "1.16.0",
    "form-data": "4.0.6",
    "graceful-fs": "4.2.11",
    "marked": "17.0.1"
  },
  "files": [
    "main.js",
    "main/**/*",
    "index.d.ts",
    "node_modules",
    "package.json",
    "icon.icns",
    "icon.ico"
  ],
  "build": {
    "appId": "net.deepnest.app",
    "copyright": "2026 deepnest-next Community",
    "nodeGypRebuild": false,
    "files": [
      "**/*",
      "build/**/*.js",
      "!**/deepnest-v*",
      "!**/out",
      "!**/playwright-*",
      "!**/test*",
      "!**/*.ts",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/package-lock.json",
      "!test**",
      "!.readthedocs.yaml",
      "!**/._*",
      "!{examples,helper_scripts}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.vscode,.husky,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "icon": "icon.ico",
      "artifactName": "${name}-v${version}-win32-${arch}.${ext}",
      "signAndEditExecutable": true,
      "forceCodeSigning": true,
      "signExts": [
        ".node",
        ".exe",
        ".dll",
        ".sys",
        ".msi",
        ".appx",
        ".appxbundle"
      ],
      "signtoolOptions": {
        "sign": "./helper_scripts/sign_windows.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "flatpak",
        "rpm"
      ],
      "icon": "icon.icns",
      "executableName": "deepnest",
      "category": "Graphics",
      "synopsis": "Deep nesting for Laser and CNC",
      "description": "Open-source nesting for laser/plasma cutters and CNC machines; packs 2D parts tightly to minimize material waste.",
      "artifactName": "${name}-v${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Deepnest",
          "GenericName": "Nesting Application",
          "Comment": "Deep nesting for Laser and CNC",
          "Categories": "Graphics;Engineering;2DGraphics;",
          "Keywords": "nesting;CAD;CNC;laser;SVG;DXF;cutting;",
          "StartupWMClass": "deepnest"
        }
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "branch": "stable",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications",
        "--env=ELECTRON_TRASH=gio"
      ],
      "files": [
        [
          "dist-resources/net.deepnest.app.metainfo.xml",
          "/share/metainfo/net.deepnest.app.metainfo.xml"
        ]
      ]
    }
  },
  "contributors": [
    {
      "name": "Josef Fröhle",
      "email": "github@josef-froehle.de"
    }
  ]
}
